# --- printer (Moonraker) ------------------------------------------------------
CREALITY_PRINTER_URL=http://192.168.1.42:7125
CREALITY_PRINTER_MODEL=hi-combo
# CREALITY_API_KEY=
CREALITY_DRY_RUN=true
CREALITY_ALLOW_PUBLIC_NETWORK=false
# CREALITY_ALLOWED_HOSTS=printer.local,192.168.1.42
CREALITY_REQUEST_TIMEOUT_MS=10000
CREALITY_UPLOAD_TIMEOUT_MS=120000
CREALITY_CONFIRMATION_TTL_MS=120000
CREALITY_MAX_UPLOAD_BYTES=134217728
CREALITY_AUDIT_LOG_PATH=./audit.jsonl

# --- CAD workspace (OpenSCAD) -------------------------------------------------
# Where model projects live. One directory per project: model.scad + project.json.
CREALITY_MODEL_WORKSPACE=./model-workspace
# Explicit OpenSCAD binary. Leave unset to probe the usual locations
# (openscad.com / openscad.exe on Windows, openscad elsewhere).
# CREALITY_OPENSCAD_PATH=C:\Program Files\OpenSCAD\openscad.com
# Wall-clock ceiling for one render or export (1000-600000).
CREALITY_OPENSCAD_TIMEOUT_MS=60000
# Captured stdout/stderr per stream; output beyond this is dropped (1024-8388608).
CREALITY_OPENSCAD_MAX_OUTPUT_BYTES=262144
# Concurrent OpenSCAD processes (1-8). Rendering is CPU-bound.
CREALITY_OPENSCAD_MAX_CONCURRENCY=2
# Ceiling on a single .scad source (1024-8388608).
CREALITY_MODEL_MAX_SOURCE_BYTES=524288

# --- local model editor -------------------------------------------------------
# Loopback only: 127.0.0.1, localhost or ::1. Any other value is refused.
CREALITY_MODEL_WEB_HOST=127.0.0.1
CREALITY_MODEL_WEB_PORT=7420
